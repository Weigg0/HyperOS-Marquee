<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F5F5">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <!-- 常规设置 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="常规设置" android:textSize="18sp" android:textStyle="bold" android:paddingTop="8dp"/>

        <Switch android:id="@+id/swEnabled" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="启用跑马灯" android:checked="true" android:paddingTop="8dp"/>

        <RadioGroup android:id="@+id/rgMode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
            <RadioButton android:id="@+id/rbAlways" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="常亮"/>
            <RadioButton android:id="@+id/rbNotify" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="通知时显示" android:checked="true"/>
        </RadioGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="通知显示时长"/>
            <TextView android:id="@+id/tvDur" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="3s"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seekDuration" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="10" android:progress="3"/>

        <!-- 位置设置 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="位置设置" android:textSize="18sp" android:textStyle="bold" android:paddingTop="16dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="宽度(0=全屏)"/>
            <TextView android:id="@+id/tvW" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="全屏"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seekW" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="1080"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="高度(0=全屏)"/>
            <TextView android:id="@+id/tvH" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="全屏"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seekH" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="2400"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="水平偏移"/>
            <TextView android:id="@+id/tvOH" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seekOH" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="600" android:progress="300"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="垂直偏移(负=上移)"/>
            <TextView android:id="@+id/tvOV" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seekOV" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="600" android:progress="300"/>

        <!-- 线条样式 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="线条样式" android:textSize="18sp" android:textStyle="bold" android:paddingTop="16dp"/>

        <Spinner android:id="@+id/spinnerStyle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:entries="@array/style_names" android:paddingTop="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="线条宽度"/>
            <TextView android:id="@+id/tvLW" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="2.0dp"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seekLW" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="20" android:progress="4"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="跑马速度"/>
            <TextView android:id="@+id/tvSpd" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="5.0"/>
        </LinearLayout>
        <SeekBar android:id="@+id/seekSpeed" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="20" android:progress="10"/>

        <!-- 圆角设置 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="圆角设置" android:textSize="18sp" android:textStyle="bold" android:paddingTop="16dp"/>

        <Switch android:id="@+id/swUnify" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="四角统一" android:checked="true" android:paddingTop="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="左上"/><TextView android:id="@+id/tvCTL"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="59dp"/></LinearLayout>
        <SeekBar android:id="@+id/seekCTL" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="120" android:progress="59"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="右上"/><TextView android:id="@+id/tvCTR"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="59dp"/></LinearLayout>
        <SeekBar android:id="@+id/seekCTR" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="120" android:progress="59"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="左下"/><TextView android:id="@+id/tvCBL"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="59dp"/></LinearLayout>
        <SeekBar android:id="@+id/seekCBL" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="120" android:progress="59"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="右下"/><TextView android:id="@+id/tvCBR"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="59dp"/></LinearLayout>
        <SeekBar android:id="@+id/seekCBR" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="120" android:progress="59"/>

        <!-- 按钮 -->
        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="保存并应用"
            android:layout_marginTop="24dp" android:backgroundTint="#1A73E8" android:textColor="#FFF"/>
        <Button android:id="@+id/btnPreview" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="预览一次（测试消息）"
            android:layout_marginTop="8dp" android:backgroundTint="#1A73E8" android:textColor="#FFF"/>

    </LinearLayout>
</ScrollView>
